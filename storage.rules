rules_version = '2';

// ══════════════════════════════════════════════════════
// WritingReview – Storage security rules
// A modell leírása: docs/adatmodell.md
// ══════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // ── SEGÉDFÜGGVÉNYEK ──

    function belepve() {
      return request.auth != null;
    }

    function tanar() {
      return belepve()
        && 'szerep' in request.auth.token
        && request.auth.token.szerep == 'tanar';
    }

    function kepVagyPdf() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf';
    }

    function maxTizMega() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // ══════════════════════════════════════════
    // FELADATLAPOK
    // A diák nem innen olvassa: a feladat dokumentumban tárolt
    // tokenes letöltési URL-t használja.
    // ══════════════════════════════════════════
    match /feladatlapok/{tanarUid}/{fajl} {
      allow read: if belepve() && request.auth.uid == tanarUid;

      allow create: if resource == null
        && tanar()
        && request.auth.uid == tanarUid
        && kepVagyPdf()
        && maxTizMega();

      // Feltöltött feladatlapot nem írunk felül és nem törlünk kliensről –
      // a feladat dokumentumok hivatkoznak rá.
      allow update, delete: if false;
    }

    // ── MINDEN MÁS TILTOTT ──
    // A dolgozatfotók útvonala (beadasok/) 2026-11-12 óta nincs: a beadás beírt szöveg.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
