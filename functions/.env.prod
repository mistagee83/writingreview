KORNYEZET=prod
# A prod 2026-11-17 óta a közös mrashub-projektben fut (4d), a hosting site: mrashub-review.
# Egyéni domain(ek) a CORS-hoz, vesszővel elválasztva (https://...). Saját aldomain 2026-11-20 óta: review.mrandrewshub.com
ENGEDELYEZETT_DOMAINEK=https://review.mrandrewshub.com,https://mrashub-review.web.app,https://mrashub-review.firebaseapp.com

# A hub fiókoldala (kredit, Hub pass) és adminja (kézi jóváírás). A fizetés a hub fizetési központjában van,
# a WR-ben nincs Stripe-kód. A hub élesben: https://mrandrewshub.com (2026-11-20).
HUB_FIOK_URL=https://mrandrewshub.com/account
HUB_ADMIN_URL=https://mrandrewshub.com/admin/#/credits

# App Check a diákoldali függvényeken (linkAdatok, linkBeadas, diakVisszajelzes): APP_CHECK=igen kapcsolja be.
# CSAK AKKOR kapcsold be, ha a config/prod.json app_check_kulcs mezőjében már van reCAPTCHA Enterprise webkulcs,
# a hosting kiment vele, és a Firebase-konzolon (App Check → Metrics) látszik, hogy a kérések igazoltak.
# Különben minden diák-beadás elbukik. Teendők: docs/folytatas.md (8e).
APP_CHECK=

# Az Érettségi feladattár (docs/erettsegi-feladattar-terv.md): ERETTSEGI_TAR=igen nyitja meg. A jogi kérdéseket (terv 7.)
# a tulajdonos 2026-11-25-ig tisztázta; bekapcsolva 2026-11-26. A config/prod.json erettsegi_tar mezőjével együtt kell állítani.
ERETTSEGI_TAR=igen
