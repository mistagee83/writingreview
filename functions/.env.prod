KORNYEZET=prod
# Egyéni domain(ek) a CORS-hoz, vesszővel elválasztva (https://...):
ENGEDELYEZETT_DOMAINEK=https://writing-review.web.app,https://writing-review.firebaseapp.com

# Stripe-fizetés (csak a prodon). Üres = a fizetés KI van kapcsolva.
# Töltsd ki, ha a Stripe-ban létrehoztad az `alap` csomag havi árát (price_...), és a titkok be vannak állítva.
FIZETES_AR_ALAP=price_1UOzd6EaWhByoTIK4cdHPyvA
# A felületen megjelenő ár szövege (az ár maga a Stripe-ban van):
FIZETES_AR_SZOVEG=7 EUR / hó
# Ide irányítja vissza a Stripe a tanárt (https, záró perjel nélkül); üresen a projekt Firebase-címe:
FIZETES_VISSZA_URL=https://writing-review.web.app
